import pandas as pd
import numpy as np

# 1. Ingest Raw Dataset
raw_df = pd.read_csv('luxury_pricing_raw.csv')

# 2. Data Hygiene & Cleaning Pipeline
clean_df = raw_df.copy()

# Filter negative prices
clean_df = clean_df[clean_df['local_price'] > 0]

# Standardize currency to EUR base
exchange_rates = {'EUR': 1.0, 'USD': 0.92, 'GBP': 1.17, 'JPY': 0.0062}
clean_df['price_eur'] = clean_df.apply(
    lambda row: round(row['local_price'] * exchange_rates.get(row['currency'], 1.0), 2), 
    axis=1
)

# Export cleaned output
clean_df.to_csv('luxury_pricing_clean.csv', index=False)
print("Data pipeline executed successfully!")
